{
  "name": "vitaes",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.3.6",
      "dotenv": "^17.3.1",
      "convex": "^1.32.0",
      "better-auth": "1.4.9",
      "@convex-dev/better-auth": "^0.10.13",
      "tailwindcss": "^4.2.1",
      "@types/react-dom": "^19.2.3",
      "@tabler/icons-react": "^3.40.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.7"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F @vitaes/backend dev",
    "dev:setup": "turbo -F @vitaes/backend dev:setup",
    "check": "oxlint && oxfmt --write"
  },
  "dependencies": {
    "@vitaes/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@vitaes/config": "workspace:*",
    "oxfmt": "^0.38.0",
    "oxlint": "^1.53.0",
    "turbo": "^2.8.16",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.10"
}
